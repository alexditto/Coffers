* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore

# Design/wireframe exports are not application source — exclude from GitHub's
# language stats so the repo is detected as PHP, not HTML/JS.
export/** linguist-vendored

# Lockfiles are not hand-written source.
composer.lock linguist-generated=true
package-lock.json linguist-generated=true
